Options -Indexes
DirectorySlash Off

# Bloqueio de arquivos ocultos (.env, .git) e arquivos de configuração sensíveis
<IfModule mod_authz_core.c>
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
    <FilesMatch "(composer\.(json|lock)|package\.json|package-lock\.json|phpunit\.xml|README\.md|LICENSE)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^\.">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <FilesMatch "(composer\.(json|lock)|package\.json|package-lock\.json|phpunit\.xml|README\.md|LICENSE)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloqueia acesso direto a diretórios internos sem rotas públicas (storage, tests, vendor)
    RewriteRule ^(storage|tests|vendor)(\/|$) - [F,L,NC]

    # Bloqueia acesso direto a arquivos PHP de código interno nas pastas app, routes e views
    RewriteRule ^(app|routes|views)\/.*\.php$ - [F,L,NC]

    # Redireciona o tráfego da aplicação para o document root público
    RewriteRule ^$ public/ [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>